# Test environment for the RLS integration suite.
# Copy to `.env.test` (gitignored) and fill in the values printed by `npm run db:start`.
#
# These MUST point at the LOCAL Supabase stack (127.0.0.1 / localhost) — the suite
# creates and deletes users, so never aim it at a hosted project.
SUPABASE_URL=http://127.0.0.1:54321

# MUST be the Publishable (anon) key — NEVER the Secret (service_role) key.
# The Secret key bypasses Row-Level Security, so every owner-isolation assertion
# would pass while proving nothing. See docs/reference/data-access.md.
SUPABASE_KEY=###

# Secret (service_role) key — used ONLY by tests/rls/profiles.cascade.test.ts to
# delete an auth.users row (an admin-only operation). It bypasses RLS, so it MUST
# NOT be used anywhere in the owner-isolation suite. Local stack only.
SUPABASE_SERVICE_KEY=###
