---
// The ground the auth screens sit on. The design has no card here — the form
// floats directly on a warm radial glow that fades into the page background,
// and the only white surfaces are the inputs themselves.
//
// Both stops are theme tokens, so the glow follows the palette: warm pink in
// light, plum-brown in dark, and flat in high contrast (where --auth-glow equals
// --background, collapsing the gradient rather than softening an edge that mode
// exists to keep hard).
//
// The theme toggle lives here rather than in the signed-in AppBar: these screens
// are the ones a visitor without a session sees, and AppBar never renders for
// them — a toggle there would be unreachable from exactly the screens that need it.
import ThemeToggle from "@/components/ThemeToggle";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";

interface Props {
  /** Renders the design's desktop two-column layout at lg and above, with this
   *  text in the accent panel. Omit for a single centred column at every width. */
  heroTitle?: string;
  heroSubtitle?: string;
}

const { heroTitle, heroSubtitle } = Astro.props;
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
const hasHero = Boolean(heroTitle);
---

<div
  class="flex min-h-screen flex-col items-center justify-center px-5 py-10"
  style="background-image: radial-gradient(120% 70% at 50% -8%, var(--auth-glow) 0%, var(--background) 46%);"
>
  <div class:list={["w-full", hasHero ? "max-w-4xl" : "max-w-sm"]}>
    <div class="mb-6 flex items-center justify-end">
      <ThemeToggle initialTheme={theme} client:load />
    </div>

    <div class:list={["gap-10", hasHero && "lg:grid lg:grid-cols-2 lg:items-center"]}>
      {
        hasHero && (
          <div class="bg-secondary text-secondary-foreground hidden rounded-lg p-10 lg:block">
            <p class="font-heading text-[28px] leading-[1.15] font-bold">{heroTitle}</p>
            {/* No opacity dimming: it costs real contrast, and worst in the mode that
                exists to maximise it. The colour comes from the token alone. */}
            {heroSubtitle && <p class="mt-3 text-[15px]">{heroSubtitle}</p>}
          </div>
        )
      }
      <div class="mx-auto w-full max-w-sm">
        <slot />
      </div>
    </div>
  </div>
</div>
