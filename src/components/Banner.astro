---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  /* Banner paints its own ground, so it stays legible on every page — including the
     domain screens still on the starter's navy. Colours are mixed from theme tokens
     rather than hardcoded, so it follows the palette in all three modes. */
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 700;
  }
  .banner--info {
    background: var(--secondary);
    color: var(--secondary-foreground);
    border-color: var(--border);
  }
  .banner--warning {
    background: color-mix(in srgb, var(--primary) 14%, var(--background));
    color: var(--foreground);
    border-color: var(--primary);
  }
  .banner--error {
    background: color-mix(in srgb, var(--destructive) 12%, var(--background));
    color: var(--destructive);
    border-color: color-mix(in srgb, var(--destructive) 45%, transparent);
  }
</style>
