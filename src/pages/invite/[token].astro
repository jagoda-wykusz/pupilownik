---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import { createClient } from "@/lib/supabase";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";
// formatWeekday and TIME_OF_DAY_LABEL moved to ClaimSlots with the slot grid it now owns.
import { formatDay, formatRange, TIMES_OF_DAY } from "@/lib/period-format";
import { resolveInviteView } from "@/lib/invite-view";
import { SPECIES_LABEL, type Species } from "@/lib/pet-format";
import { CLAIM_COOKIE } from "@/lib/claim-cookie";
import ClaimSlots from "@/components/invite/ClaimSlots";
import type { TimeOfDay } from "@/lib/period-format";

// The caretaker's view. Deliberately NOT in PROTECTED_ROUTES: whoever holds the link has
// no account, and that is the whole access model (docs/reference/data-access.md §token
// model). The middleware adds Referrer-Policy: no-referrer and Cache-Control: no-store for
// this prefix, because the token travels in the path.
//
// The read goes through the ordinary request-scoped client. A logged-out visitor has no
// session, so the call runs as `anon`; a signed-in owner opening their own link runs as
// `authenticated`. get_period_by_token is granted to both, so no new client type is needed
// and nothing here has to know which one it is.
//
// TWO reads, and which one runs is the whole access model:
//
//   get_period_by_token  — the link alone. Period, slots, pets, PUBLIC instruction rows.
//   get_claimed_details  — the link AND the capability cookie. Sensitive rows, the trip note,
//                          and this caretaker's own slots. Returns NULL unless that capability
//                          actually holds a claimed slot on THIS trip.
//
// The second call is made with the RAW cookie value. Both functions hash it internally, so
// nothing here derives a digest — a `digestClaimSecret` call on this page would be a mistake
// (S-03 Phase 2 impl-review F1).
//
// The two payloads PARTITION the instructions: the reveal carries only the sensitive rows, so
// the page composes them per pet rather than replacing one list with the other (Phase 3
// addendum A21). Occupancy by name is still S-04, and neither function returns it.
//
// The cookie is HttpOnly, so the island cannot read it and the sensitive rows are never handed
// to client-side code — they are rendered here, server-side, and the island reloads the page
// after a successful claim rather than swapping state in the browser.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
const token = Astro.params.token ?? "";

interface TokenSlot {
  id: string;
  slot_date: string;
  time_of_day: TimeOfDay;
  is_claimed: boolean;
}
interface TokenInstruction {
  id: string;
  title: string;
  body: string | null;
  sort_order: number;
}
interface TokenPet {
  id: string;
  name: string;
  species: Species;
  // PUBLIC rows only — see the note above. Already ordered by sort_order in SQL.
  instructions: TokenInstruction[];
}
interface TokenPayload {
  period: { id: string; title: string; start_date: string; end_date: string };
  slots: TokenSlot[];
  pets: TokenPet[];
}
interface ClaimedDetails {
  name: string;
  caretaker_note: string | null;
  slots: { id: string; slot_date: string; time_of_day: TimeOfDay }[];
  /** Same pet shape, but `instructions` carries ONLY the is_sensitive rows. */
  pets: TokenPet[];
}

let payload: TokenPayload | null = null;
let loadError = false;

if (supabase) {
  const { data, error } = await supabase.rpc("get_period_by_token", { p_token: token });
  if (error) {
    // A transport/permission failure is NOT the same as an unresolved token. Surfacing it
    // as "link nieaktywny" would tell the visitor to ask for a new link that would work
    // no better (S-01 impl-review F5, applied to the caretaker side).
    loadError = true;
  } else {
    // The function returns NULL for unknown, malformed and revoked tokens alike — see the
    // uniform-failure note below.
    payload = data as TokenPayload | null;
  }
} else {
  loadError = true;
}

// The capability read. Only attempted when the token itself resolved — there is nothing to
// reveal on a dead link, and asking would be a second query for no answer. A NULL comes back
// for a wrong secret, a capability holding nothing here, or a cookie earned on another trip;
// all three degrade silently to the pre-claim view, which is what resolveInviteView's branch
// order enforces.
let claimed: ClaimedDetails | null = null;
const claimSecret = Astro.cookies.get(CLAIM_COOKIE)?.value;

if (supabase && payload && claimSecret) {
  const { data, error } = await supabase.rpc("get_claimed_details", {
    p_token: token,
    p_claim_secret: claimSecret,
  });
  // A failure here is NOT a page failure: the public half already loaded, and showing the
  // error page would hide a trip the visitor can legitimately see. Degrade to pre-claim.
  claimed = error ? null : (data as ClaimedDetails | null);
}

// Unknown, tampered, malformed and revoked tokens all land on one page with one status and
// one title. That uniformity is a security property, not a UX choice: a distinct "this link
// was revoked" answer would confirm the period exists. The decision lives in
// resolveInviteView so it is pinned by tests/unit/invite-view.test.ts rather than by an `if`
// nobody checks — this exact shape (a status set inside a branch) is what the phase-3 review
// had to catch by reading, because no test could.
const view = resolveInviteView({
  failed: loadError,
  periodTitle: payload?.period.title ?? null,
  hasClaims: claimed !== null,
});
const inactive = view.kind === "inactive";
Astro.response.status = view.status;

const slots = payload?.slots ?? [];
const byDay = [...new Set(slots.map((slot) => slot.slot_date))].sort().map((day) => ({
  day,
  slots: TIMES_OF_DAY.map((time) => slots.find((slot) => slot.slot_date === day && slot.time_of_day === time)).filter(
    (slot) => slot !== undefined,
  ),
}));
const freeCount = slots.filter((slot) => !slot.is_claimed).length;

// A period with ZERO pets is representable by decision: create_period_with_slots enforces
// "at least one pet" and nothing else does, so a raw insert or a deleted last pet both
// produce one. The function answers `pets: []` rather than null for exactly this reason, and
// the block below is skipped rather than rendering an empty heading.
const pets = payload?.pets ?? [];

// Compose the two payloads per pet. The reveal returns only sensitive rows and only for a
// caretaker who claimed, so before that this map is empty and every pet renders its public
// list alone. Keyed by pet id rather than by index: the two payloads order pets identically
// today (both `order by pet.name, pet.id`), but relying on that would make a future ordering
// change a silent mismatch of instructions to animals.
const sensitiveByPet = new Map((claimed?.pets ?? []).map((pet) => [pet.id, pet.instructions]));
const myDays = [...new Set((claimed?.slots ?? []).map((slot) => slot.slot_date))].sort();
---

<Layout title={view.title}>
  <div class="bg-background min-h-screen px-5 py-8">
    <div class="mx-auto w-full max-w-2xl">
      <div class="mb-6 flex items-center justify-end">
        <ThemeToggle initialTheme={theme} client:load />
      </div>

      {
        view.kind === "error" && (
          <p
            role="alert"
            class="border-destructive/40 bg-destructive/10 text-destructive rounded-lg border-[1.5px] px-4 py-3 text-[14px]"
          >
            Nie udało się teraz wczytać wyjazdu. Odśwież stronę za chwilę — link jest w porządku.
          </p>
        )
      }

      {
        inactive && (
          <div class="border-border bg-card rounded-lg border-[1.5px] p-8 text-center">
            <p class="font-heading text-foreground text-[20px] font-bold">{view.title}</p>
            <p class="text-muted-foreground mt-3 text-[15px]">
              Ten link nie działa. Poproś właściciela zwierzęcia o nowy — poprzedni mógł zostać zastąpiony.
            </p>
          </div>
        )
      }

      {
        payload && (
          <>
            <p class="text-muted-foreground text-[13px] font-bold tracking-wide">POMOC W OPIECE</p>
            <h1 class="font-heading text-foreground mt-1 text-[30px] leading-[1.15] font-bold">
              {payload.period.title}
            </h1>
            <p class="text-primary mt-1 text-[15px] font-semibold">
              {formatRange(payload.period.start_date, payload.period.end_date)}
            </p>
            <p class="text-muted-foreground mt-2 text-[15px]">
              {freeCount === 0
                ? "Wszystkie terminy są już zajęte."
                : `Wolnych terminów: ${freeCount} z ${slots.length}.`}
            </p>

            {claimed && (
              <div class="border-primary bg-secondary mt-6 rounded-lg border-[1.5px] p-4">
                <p class="text-secondary-foreground text-[15px] font-bold">Zapisano, {claimed.name}!</p>
                <p class="text-secondary-foreground mt-1 text-[14px]">
                  {myDays.length === 1
                    ? `Masz 1 dzień: ${formatDay(myDays[0])}.`
                    : `Masz ${myDays.length} dni: ${myDays.map((day) => formatDay(day)).join(", ")}.`}
                </p>
              </div>
            )}

            {pets.length > 0 && (
              <>
                <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Zwierzaki</h2>
                <ul class="space-y-3">
                  {pets.map((pet) => (
                    <li class="border-border bg-card rounded-lg border-[1.5px] p-4">
                      <p class="text-foreground text-[15px] font-bold">
                        {pet.name}
                        <span class="text-muted-foreground ml-2 text-[13px] font-normal">
                          {SPECIES_LABEL[pet.species]}
                        </span>
                      </p>
                      {pet.instructions.length === 0 && (sensitiveByPet.get(pet.id) ?? []).length === 0 ? (
                        <p class="text-muted-foreground mt-2 text-[13px]">
                          Właściciel nie dodał jeszcze wskazówek dla tego zwierzaka.
                        </p>
                      ) : (
                        <>
                          {pet.instructions.length > 0 && (
                            <ul class="mt-3 space-y-2">
                              {pet.instructions.map((instruction) => (
                                <li class="border-input rounded-lg border-[1.5px] px-3 py-2">
                                  <p class="text-foreground text-[14px] font-semibold">{instruction.title}</p>
                                  {instruction.body && (
                                    <p class="text-muted-foreground mt-1 text-[13px] leading-[1.5]">
                                      {instruction.body}
                                    </p>
                                  )}
                                </li>
                              ))}
                            </ul>
                          )}
                          {/* The sensitive tier, visually SEPARATED rather than merged into the
                              list above: the design draws it as its own callout, and mixing the
                              two would lose the distinction this whole slice is about. Phase 5
                              gives it the designed treatment; --destructive is the closest
                              existing token that reads as "handle with care". */}
                          {(sensitiveByPet.get(pet.id) ?? []).length > 0 && (
                            <ul class="mt-3 space-y-2">
                              {(sensitiveByPet.get(pet.id) ?? []).map((instruction) => (
                                <li class="border-destructive/40 bg-destructive/10 rounded-lg border-[1.5px] px-3 py-2">
                                  <p class="text-foreground text-[14px] font-semibold">{instruction.title}</p>
                                  {instruction.body && (
                                    <p class="text-muted-foreground mt-1 text-[13px] leading-[1.5]">
                                      {instruction.body}
                                    </p>
                                  )}
                                </li>
                              ))}
                            </ul>
                          )}
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}

            {claimed?.caretaker_note && (
              <>
                <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Notatka od właściciela</h2>
                <p class="border-destructive/40 bg-destructive/10 text-foreground rounded-lg border-[1.5px] p-4 text-[14px] leading-[1.6] whitespace-pre-line">
                  {claimed.caretaker_note}
                </p>
              </>
            )}

            <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Terminy</h2>
            {/* The island replaces the read-only list Phase 3 left behind. `byDay` was already
                the natural serializable prop.

                What crosses to the client, precisely: the capability contributes only
                `hasCapability`, a boolean — the secret stays in an HttpOnly cookie the browser
                cannot read, and the revealed rows are rendered above, server-side. The TOKEN
                does cross, as a prop, and Astro serializes island props into the HTML, so it
                now has a second copy in the DOM. That is not an escalation — it is already in
                this page's URL, and the response carries no-referrer and no-store — but the
                earlier wording here implied nothing credential-shaped crossed at all, which
                was true of the capability and false of the token (Phase 4 impl-review F9). */}
            <ClaimSlots byDay={byDay} token={token} hasCapability={claimed !== null} client:load />

            {/* The tier hint, now that claiming exists. Shown only BEFORE claiming: once the
                sensitive rows are on the page, saying they are withheld would be false. Kept
                outside the pets guard for the reason Phase 3's review gave - a trip with no
                linked pets is representable and still needs the explanation. */}
            {/* Reads view.kind, not `claimed`, because this is a pure VIEW decision with no
                payload behind it — which makes the fourth kind load-bearing rather than
                computed-and-ignored (impl-review). The blocks above keep `claimed &&` because
                they dereference it and need TypeScript's narrowing; inside this `payload`
                branch the two are equivalent by construction, since hasClaims is exactly
                `claimed !== null`. */}
            {view.kind === "period" && (
              <p class="text-muted-foreground mt-6 text-[13px] leading-[1.5]">
                Część wskazówek — na przykład dostęp do mieszkania — właściciel udostępnia dopiero po zapisaniu się na
                termin.
              </p>
            )}
          </>
        )
      }
    </div>
  </div>
</Layout>
