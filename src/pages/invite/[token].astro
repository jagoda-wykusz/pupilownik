---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import { createClient } from "@/lib/supabase";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";
// formatWeekday and TIME_OF_DAY_LABEL moved to ClaimSlots with the slot grid it now owns.
import { formatDay, formatRange, TIMES_OF_DAY } from "@/lib/period-format";
import { composeCaretakerView, resolveInviteView, splitRevealAnswer, type RevokedClaim } from "@/lib/invite-view";
import { SPECIES_LABEL, type Species } from "@/lib/pet-format";
import { CAPABILITY_SHAPE, CLAIM_COOKIE } from "@/lib/claim-cookie";
import ClaimSlots from "@/components/invite/ClaimSlots";
import type { TimeOfDay } from "@/lib/period-format";

// The caretaker's view. Deliberately NOT in PROTECTED_ROUTES: whoever holds the link has
// no account, and that is the whole access model (docs/reference/data-access.md §token
// model). The middleware adds Referrer-Policy: no-referrer and Cache-Control: no-store for
// this prefix, because the token travels in the path.
//
// The read goes through the ordinary request-scoped client. A logged-out visitor has no
// session, so the call runs as `anon`; a signed-in owner opening their own link runs as
// `authenticated`. get_period_by_token is granted to both, so no new client type is needed
// and nothing here has to know which one it is.
//
// TWO reads, and which one runs is the whole access model:
//
//   get_period_by_token  — the link alone. Period, slots, pets, PUBLIC instruction rows.
//   get_claimed_details  — the link AND the capability cookie. Sensitive rows, the trip note,
//                          and this caretaker's own slots. Returns NULL unless that capability
//                          actually holds a claimed slot on THIS trip.
//
// The second call is made with the RAW cookie value. Both functions hash it internally, so
// nothing here derives a digest — a `digestClaimSecret` call on this page would be a mistake
// (S-03 Phase 2 impl-review F1).
//
// The two payloads PARTITION the instructions: the reveal carries only the sensitive rows, so
// the page composes them per pet rather than replacing one list with the other (Phase 3
// addendum A21). Occupancy by name is still S-04, and neither function returns it.
//
// The cookie is HttpOnly, so the island cannot read it and the sensitive rows are never handed
// to client-side code — they are rendered here, server-side, and the island reloads the page
// after a successful claim rather than swapping state in the browser.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
const token = Astro.params.token ?? "";

interface TokenSlot {
  id: string;
  slot_date: string;
  time_of_day: TimeOfDay;
  is_claimed: boolean;
}
interface TokenInstruction {
  id: string;
  title: string;
  body: string | null;
  sort_order: number;
}
interface TokenPet {
  id: string;
  name: string;
  species: Species;
  // PUBLIC rows only — see the note above. Already ordered by sort_order in SQL.
  instructions: TokenInstruction[];
}
interface TokenPayload {
  period: { id: string; title: string; start_date: string; end_date: string };
  slots: TokenSlot[];
  pets: TokenPet[];
}
interface ClaimedDetails {
  name: string;
  caretaker_note: string | null;
  slots: { id: string; slot_date: string; time_of_day: TimeOfDay }[];
  /** Same pet shape, but `instructions` carries ONLY the is_sensitive rows. */
  pets: TokenPet[];
}

/* RevokedClaim — what the reveal door answers for a proven claim-holder on a REVOKED period
   (S-06 Phase 2) — is imported from invite-view alongside the split that consumes it.
   Deliberately carries no trip content: not the title, not the dates, not the pets. The
   called-off card is therefore unable to name the trip, which is the point, since it is
   reachable with only a cookie. */

let payload: TokenPayload | null = null;
let loadError = false;

if (supabase) {
  const { data, error } = await supabase.rpc("get_period_by_token", { p_token: token });
  if (error) {
    // A transport/permission failure is NOT the same as an unresolved token. Surfacing it
    // as "link nieaktywny" would tell the visitor to ask for a new link that would work
    // no better (S-01 impl-review F5, applied to the caretaker side).
    //
    // The visitor's answer stays exactly that. What changed on 2026-09-13 is that the SERVER
    // now says so too: this branch used to set the flag and record nothing, so a persistent
    // RPC failure was invisible to everyone. `code` and `message` only — never the whole error
    // (a `postgres`-owned SECURITY DEFINER function receives the failing row in `details`) and
    // never `token`, which is a bearer credential.
    console.error("get_period_by_token failed:", error.code, error.message);
    loadError = true;
  } else {
    // The function returns NULL for unknown, malformed and revoked tokens alike — see the
    // uniform-failure note below.
    payload = data as TokenPayload | null;
  }
} else {
  loadError = true;
}

// The capability read. Attempted whenever a claim cookie is present — INCLUDING when the token
// itself did not resolve, which is the change S-06 Phase 2 needed.
//
// It used to be gated on `payload`, on the reasoning that there is nothing to reveal on a dead
// link. That reasoning had a hole: a revoked period is exactly a dead link that still has
// something to say, and only this door can say it, because only it can check the claim_digest.
// With the old gate the new SQL branch was unreachable — `payload` is null precisely when the
// period is revoked.
//
// The cost is one extra RPC per dead-link view that carries a WELL-FORMED claim cookie — the
// shape gate below is what narrows it from "any cookie", and it landed in Phase 3 precisely
// because "bounded before anything is hashed" was true of the function and not of the request:
// a garbage cookie still bought a serialize, transport and parse before the 43-char check could
// reject it (Phase 2 impl-review F9). Past the gate, both arguments are bounded before anything
// is hashed and the lookup is by unique digest, so a miss is a primary-key-shaped no-op.
//
// A NULL still comes back for a wrong secret, a capability holding nothing here, or a cookie
// earned on another trip; all three degrade silently, which is what resolveInviteView's branch
// order enforces. `{revoked: true}` is the one non-null answer that does NOT carry content.
let claimed: ClaimedDetails | RevokedClaim | null = null;
// Shape-gated before it is spent (S-06 Phase 3, from Phase 2's impl-review F9). Ungating the
// reveal means ANY request to /invite/<anything> carrying this cookie issues an RPC, and
// HttpOnly binds browsers, not curl — so without this, a garbage cookie buys a serialize,
// transport and parse round trip before the function's own 43-char bound rejects it. The claim
// route has always gated on the same regex; the page and the route now agree on what a
// well-formed capability looks like.
//
// Behaviour must NOT change for anyone: a malformed secret was already a guaranteed miss, so a
// rejected cookie has to degrade exactly as that NULL did — `claimed` stays null and the page
// renders the uniform inactive card. That is why the gate lives in this condition and not in a
// separate branch that could grow its own answer.
const rawClaimSecret = Astro.cookies.get(CLAIM_COOKIE)?.value;
const claimSecret = rawClaimSecret !== undefined && CAPABILITY_SHAPE.test(rawClaimSecret) ? rawClaimSecret : undefined;

if (supabase && claimSecret) {
  const { data, error } = await supabase.rpc("get_claimed_details", {
    p_token: token,
    p_claim_secret: claimSecret,
  });
  // A failure here is NOT a page failure: the public half already loaded, and showing the
  // error page would hide a trip the visitor can legitimately see. Degrade to pre-claim.
  //
  // THE DEGRADATION IS UNCHANGED; ITS SILENCE IS NOT. Until 2026-09-13 this was a ternary that
  // discarded `error` outright — no log, no signal of any kind. That made it the worst failure on
  // this page: a caretaker who HAS claimed gets served the pre-claim view at status 200, their
  // instructions simply gone, and nobody on either side of the screen learns anything. The `if`
  // exists only because a ternary has no statement position to log from.
  //
  // Same discipline as every other call site: `code` and `message`, never the whole error (a
  // `postgres`-owned SECURITY DEFINER function receives the failing row in `details`), and never
  // `claimSecret`, which is the caretaker's bearer credential.
  if (error) {
    console.error("get_claimed_details failed:", error.code, error.message);
    claimed = null;
  } else {
    claimed = data as ClaimedDetails | RevokedClaim | null;
  }
}

// The reveal answer, split into the two things the page does with it. The split lives in
// invite-view.ts, next to resolveInviteView and pinned by tests/unit/invite-view.test.ts,
// because it carries a security property: `details` is what every renderer of trip content
// reads, and it must be null for the revoked answer. Inline here it was two ternaries enforced
// by nothing (impl-review F4).
//
// That module now holds THREE decisions of this page, pinned by one test file each: the split
// and the view resolution here, and composeCaretakerView in
// tests/unit/invite-composition.test.ts. This sentence used to promise a single shared test
// file; it stopped being true when the third arrived (Phase 4 impl-review F7).
const { details, claimRevoked } = splitRevealAnswer<ClaimedDetails>(claimed);

// Unknown, tampered and malformed tokens all land on one page with one status and one title,
// and so does a revoked one for everybody who cannot prove a claim on it. That uniformity is a
// security property, not a UX choice: a distinct "this link was revoked" answer would confirm
// the period exists to a caller who had no way of knowing. The decision lives in
// resolveInviteView so it is pinned by tests/unit/invite-view.test.ts rather than by an `if`
// nobody checks — this exact shape (a status set inside a branch) is what the phase-3 review
// had to catch by reading, because no test could.
//
// S-06 Phase 2's exception rides on `claimRevoked`, which is true only for the door's
// `{revoked: true}` — i.e. behind the claim_digest gate. Same status, same title, different
// body. Note `hasClaims` reads `details`, not `claimed`: the revoked answer must not be
// counted as holding slots, or a future edit could route it to the post-claim view.
const view = resolveInviteView({
  failed: loadError,
  periodTitle: payload?.period.title ?? null,
  hasClaims: details !== null,
  claimRevoked,
});
const inactive = view.kind === "inactive";
const revoked = view.kind === "revoked";
Astro.response.status = view.status;

const slots = payload?.slots ?? [];
const byDay = [...new Set(slots.map((slot) => slot.slot_date))].sort().map((day) => ({
  day,
  slots: TIMES_OF_DAY.map((time) => slots.find((slot) => slot.slot_date === day && slot.time_of_day === time)).filter(
    (slot) => slot !== undefined,
  ),
}));
const freeCount = slots.filter((slot) => !slot.is_claimed).length;

// A period with ZERO pets is representable by decision: create_period_with_slots enforces
// "at least one pet" and nothing else does, so a raw insert or a deleted last pet both
// produce one. The function answers `pets: []` rather than null for exactly this reason, and
// the block below is skipped rather than rendering an empty heading.
//
// Composing the two payloads per pet — and deciding whether the note may be shown at all — is
// NOT done here. It moved to composeCaretakerView in invite-view.ts, next to the two other
// decisions of this page that carry a security property, because inline it was a Map and a
// ternary enforced by nothing: rebuilding either from `payload` instead of `details` would have
// handed the sensitive tier to every holder of the link with the whole suite still green
// (test-plan.md §3 Phase 4, Risk #4). What comes back is already safe to render, which is why
// nothing below the fence reads `details` for instructions or for the note.
const { pets, caretakerNote } = composeCaretakerView({ pets: payload?.pets ?? [], details });
const myDays = [...new Set((details?.slots ?? []).map((slot) => slot.slot_date))].sort();
---

<Layout title={view.title}>
  <div class="bg-background min-h-screen px-5 py-8">
    <div class="mx-auto w-full max-w-2xl">
      <div class="mb-6 flex items-center justify-end">
        <ThemeToggle initialTheme={theme} client:load />
      </div>

      {
        view.kind === "error" && (
          <p
            role="alert"
            class="border-destructive/40 bg-destructive/10 text-destructive rounded-lg border-[1.5px] px-4 py-3 text-[14px]"
          >
            Nie udało się teraz wczytać wyjazdu. Odśwież stronę za chwilę — link jest w porządku.
          </p>
        )
      }

      {
        inactive && (
          /* The generic dead link: unknown, tampered, malformed, or revoked-and-unproven.
             The earlier copy said "Poproś właściciela o nowy — poprzedni mógł zostać
             zastąpiony", which sends the visitor after something the owner may be unable to
             issue: RegenerateLinkButton refuses a revoked period, and S-06 Phase 1 made that
             refusal a property of the database. So the promise is dropped and only what is
             true in every case that reaches this card is left — the link is dead, and any
             replacement has to come from the owner if the trip is still on. */
          <div class="border-border bg-card rounded-lg border-[1.5px] p-8 text-center">
            <p class="font-heading text-foreground text-[20px] font-bold">{view.title}</p>
            <p class="text-muted-foreground mt-3 text-[15px]">
              Ten link nie działa. Jeśli wyjazd nadal się odbywa, właściciel zwierzęcia musi udostępnić Ci nowy link.
            </p>
          </div>
        )
      }

      {
        revoked && (
          /* S-06 Phase 2. Reached ONLY by a visitor whose claim_digest matched a slot row in
             this very period — see get_claimed_details. Same status and title as the card
             above; only this body differs.

             It deliberately does NOT name the trip or its dates: the payload behind this card
             carries no content at all, and the card is reachable with just a cookie on a
             shared phone. It also does not promise that the owner will be in touch — this
             product has no channel to the caretaker and no non-goal permits inventing one
             (the PRD's push/email non-goal governs what the system pushes outward, not what a page says when
             opened). Telling them they need not come is the actionable half. */
          <div class="border-border bg-card rounded-lg border-[1.5px] p-8 text-center">
            <p class="font-heading text-foreground text-[20px] font-bold">{view.title}</p>
            <p class="text-muted-foreground mt-3 text-[15px]">
              Wyjazd został odwołany, więc Twoja pomoc nie jest już potrzebna — nie musisz przychodzić. Terminy, które
              zajęłaś lub zająłeś, przestały obowiązywać.
            </p>
          </div>
        )
      }

      {
        payload && (
          <>
            <p class="text-muted-foreground text-[13px] font-bold tracking-wide">POMOC W OPIECE</p>
            <h1 class="font-heading text-foreground mt-1 text-[30px] leading-[1.15] font-bold">
              {payload.period.title}
            </h1>
            <p class="text-primary mt-1 text-[15px] font-semibold">
              {formatRange(payload.period.start_date, payload.period.end_date)}
            </p>
            <p class="text-muted-foreground mt-2 text-[15px]">
              {freeCount === 0
                ? "Wszystkie terminy są już zajęte."
                : `Wolnych terminów: ${freeCount} z ${slots.length}.`}
            </p>

            {/* The success banner. The design draws it as a full-bleed gradient hero with a
                white tick (the post-claim artboard, tpl 72-77); this page is a plain document
                rather than a phone mock, so it lands as a card in the --success accent the
                phase added — same anatomy (tick, "Zapisano!", the day count), same tokens as
                the rest of the page. Body text stays on --foreground: --success is an accent,
                and only the heading is set in it. */}
            {details && (
              <div class="border-success bg-success/10 mt-6 flex items-center gap-3 rounded-lg border-[1.5px] p-4">
                <span class="bg-success/15 text-success flex size-11 shrink-0 items-center justify-center rounded-full">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <div>
                  {/* Heading on --foreground, not --success: at 18px bold this is 13.5pt, under
                      WCAG's 14pt-bold large-text threshold, so it needs 4.5:1 — and #2f7d52 on
                      the bg-success/10 tint measures 4.13:1, not the 4.9:1 the token's comment
                      cites against --background (impl-review phase 5, F2). --success stays on
                      the tick disc, where the 3:1 non-text bar applies and it clears at 3.86:1. */}
                  <p class="font-heading text-foreground text-[18px] font-bold">Zapisano, {details.name}!</p>
                  <p class="text-foreground mt-0.5 text-[13px] font-semibold">
                    {myDays.length === 1
                      ? `Masz 1 dzień: ${formatDay(myDays[0])}.`
                      : `Masz ${myDays.length} dni: ${myDays.map((day) => formatDay(day)).join(", ")}.`}
                  </p>
                </div>
              </div>
            )}

            {pets.length > 0 && (
              <>
                <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Zwierzaki</h2>
                <ul class="space-y-3">
                  {pets.map((pet) => (
                    <li class="border-border bg-card rounded-lg border-[1.5px] p-4">
                      <p class="font-heading text-foreground text-[18px] font-bold">
                        {pet.name}
                        <span class="text-muted-foreground ml-2 text-[13px] font-semibold">
                          {SPECIES_LABEL[pet.species]}
                        </span>
                      </p>
                      {pet.publicInstructions.length === 0 && pet.sensitiveInstructions.length === 0 ? (
                        <p class="text-muted-foreground mt-2 text-[13px]">
                          Właściciel nie dodał jeszcze wskazówek dla tego zwierzaka.
                        </p>
                      ) : (
                        <>
                          {/* The design's instruction card: a 50px leading square in the accent
                              tint, then title and body. The square carries an ICON, not the
                              artboard's "8·18" / "wiecz." hour — `care_instructions` stores
                              (title, body, is_sensitive, sort_order) and no time at all, so a
                              time there would be invented data on the one screen where a wrong
                              dosing hour is dangerous. Decided at the phase gate, 2026-09-08. */}
                          {pet.publicInstructions.length > 0 && (
                            <ul class="mt-3 flex flex-col gap-2.5">
                              {pet.publicInstructions.map((instruction) => (
                                <li class="border-border bg-card flex gap-3 rounded-[18px] border-[1.5px] p-3.5">
                                  <span class="bg-secondary text-secondary-foreground flex size-[50px] shrink-0 items-center justify-center rounded-[15px]">
                                    <svg
                                      width="22"
                                      height="22"
                                      viewBox="0 0 24 24"
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      aria-hidden="true"
                                    >
                                      <path d="M9 6h11M9 12h11M9 18h11" />
                                      <path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
                                    </svg>
                                  </span>
                                  <div class="min-w-0 flex-1">
                                    <p class="font-heading text-foreground text-[15px] font-bold">
                                      {instruction.title}
                                    </p>
                                    {instruction.body && (
                                      <p class="text-muted-foreground mt-0.5 text-[13px] leading-[1.4]">
                                        {instruction.body}
                                      </p>
                                    )}
                                  </div>
                                </li>
                              ))}
                            </ul>
                          )}
                          {/* The sensitive tier, visually SEPARATED rather than merged into the
                              list above: the design draws it as its own amber callout (the
                              post-claim artboard's "Klucze u sąsiadki" block, tpl 105-110), and
                              mixing the two would lose the distinction this whole slice is
                              about. Phase 5 replaces Phase 3's --destructive placeholder with
                              the --notice token cut from that block: red reads as "something
                              went wrong", amber as "handle with care", and nothing here is
                              wrong. Its own heading, because a caretaker who never claimed
                              never sees this and one who did should know why it appeared. */}
                          {pet.sensitiveInstructions.length > 0 && (
                            <div class="border-notice bg-notice/10 mt-3 rounded-[18px] border-[1.5px] p-3.5">
                              <p class="text-foreground flex items-center gap-2 text-[13px] font-bold">
                                <svg
                                  width="15"
                                  height="15"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  class="text-notice"
                                  aria-hidden="true"
                                >
                                  <rect width="18" height="11" x="3" y="11" rx="2" />
                                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                                Tylko dla opiekuna
                              </p>
                              <ul class="mt-2.5 flex flex-col gap-2">
                                {pet.sensitiveInstructions.map((instruction) => (
                                  <li>
                                    <p class="font-heading text-foreground text-[14px] font-bold">
                                      {instruction.title}
                                    </p>
                                    {instruction.body && (
                                      <p class="text-foreground/80 mt-0.5 text-[13px] leading-[1.5]">
                                        {instruction.body}
                                      </p>
                                    )}
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}

            {caretakerNote && (
              <>
                {/* The design's NOTATKA, and the same amber as the sensitive rows on purpose:
                    the artboard fills this field with "Klucze u sąsiadki, mieszkanie 4…", so
                    it carries the same kind of content and earns the same reveal rule and the
                    same treatment. It arrives already gated — composeCaretakerView returns null
                    for every visitor who has not proven a claim — so this condition is a
                    presence check, not the reveal rule itself. */}
                <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Notatka od właściciela</h2>
                <p class="border-notice bg-notice/10 text-foreground rounded-[18px] border-[1.5px] p-4 text-[14px] leading-[1.6] whitespace-pre-line">
                  {caretakerNote}
                </p>
              </>
            )}

            <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Terminy</h2>
            {/* The island replaces the read-only list Phase 3 left behind. `byDay` was already
                the natural serializable prop.

                What crosses to the client, precisely: the capability contributes only
                `hasCapability`, a boolean — the secret stays in an HttpOnly cookie the browser
                cannot read, and the revealed rows are rendered above, server-side. The TOKEN
                does cross, as a prop, and Astro serializes island props into the HTML, so it
                now has a second copy in the DOM. That is not an escalation — it is already in
                this page's URL, and the response carries no-referrer and no-store — but the
                earlier wording here implied nothing credential-shaped crossed at all, which
                was true of the capability and false of the token (Phase 4 impl-review F9). */}
            <ClaimSlots byDay={byDay} token={token} hasCapability={details !== null} client:load />

            {/* The tier hint, now that claiming exists. Shown only BEFORE claiming: once the
                sensitive rows are on the page, saying they are withheld would be false. Kept
                outside the pets guard for the reason Phase 3's review gave - a trip with no
                linked pets is representable and still needs the explanation. */}
            {/* Reads view.kind, not `details`, because this is a pure VIEW decision with no
                payload behind it — which makes the fourth kind load-bearing rather than
                computed-and-ignored (impl-review). The blocks above keep `details &&` because
                they dereference it and need TypeScript's narrowing; inside this `payload`
                branch the two are equivalent by construction, since hasClaims is exactly
                `details !== null`. Note the revoked answer cannot reach here at all: it only
                arrives when `payload` is null, so this whole branch is skipped. */}
            {view.kind === "period" && (
              <p class="text-muted-foreground mt-6 text-[13px] leading-[1.5]">
                Część wskazówek — na przykład dostęp do mieszkania — właściciel udostępnia dopiero po zapisaniu się na
                termin.
              </p>
            )}
          </>
        )
      }
    </div>
  </div>
</Layout>
