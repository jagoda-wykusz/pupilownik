---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import RegenerateLinkButton from "@/components/periods/RegenerateLinkButton";
import ReleaseSlotButton from "@/components/periods/ReleaseSlotButton";
import { Chip } from "@/components/ui/Chip";
import { createClient } from "@/lib/supabase";
import { periodIdSchema } from "@/lib/schemas/period";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";
import { formatDay, formatRange, formatWeekday, TIMES_OF_DAY, TIME_OF_DAY_LABEL } from "@/lib/period-format";
import { groupCaretakers, UNNAMED_CARETAKER_LABEL } from "@/lib/caretaker-name";
import type { TimeOfDay } from "@/lib/period-format";

// Protected by middleware (PROTECTED_ROUTES includes "/periods"). The read carries no
// owner filter — RLS scopes it, so another owner's id resolves to nothing and lands on
// the same 404 as an id that does not exist.
//
// The invite link is deliberately absent from this screen when nothing was just
// minted: the raw token was never stored, so there is nothing to show. Regenerating is
// the only way back to a working link, and that is what the island below offers.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
// Validated the same way the API route validates it (api/periods/[id]/token.ts). Without
// this, a non-uuid reaches Postgres, raises 22P02, and this page answers 200 with a
// load-failure message — telling a probe its input was at least well-formed, and telling
// a user with a typo that something broke. A bad id is simply not found.
const parsedId = periodIdSchema.safeParse(Astro.params.id);
const periodId = parsedId.success ? parsedId.data : null;

interface SlotRow {
  id: string;
  slot_date: string;
  time_of_day: TimeOfDay;
  claimed_at: string | null;
  // S-04 (FR-006) is the slice that takes identity off this page's "cannot see it, cannot
  // leak it" footing, and it does so deliberately. Until now this interface carried only
  // `claimed_at`, on the grounds that the page needed "is this taken", not who took it — a
  // structural guarantee, since a page without the column cannot render it by accident.
  //
  // What replaces that guarantee, now that both columns are read:
  //   - `claimed_by_name` is anon-written and reaches the screen ONLY through
  //     `groupCaretakers`, which normalises it (see src/lib/caretaker-name.ts for what
  //     `claim_slots` does and does not validate).
  //   - `claim_digest` is read HERE, in server-only frontmatter, and must travel no further.
  //     Astro serializes island props into the HTML, so a digest in a prop is a disclosure —
  //     `20260907171514_claim_secret_not_digest.sql:14-19` names this payload as the one to
  //     avoid. `CaretakerLabel` has no digest field, which makes that a type error rather
  //     than a review catch, and a unit test pins the shape.
  // `/periods` keeps the old posture: its aggregate still never reads either column.
  claimed_by_name: string | null;
  claim_digest: string | null;
}
interface PetRow {
  id: string;
  name: string;
}
interface PeriodRow {
  id: string;
  title: string;
  start_date: string;
  end_date: string;
  revoked_at: string | null;
  // Read back to the owner here because this is the only screen that shows it at all: the
  // note is set once, on the create form, and from S-03 Phase 3 onwards only a caretaker who
  // claimed a slot ever sees it. Without this the field is write-only — an owner could mistype
  // a flat number and never find out. Safe to render: unlike claimed_by_name above, the note
  // is the owner's OWN input, so no caretaker-side boundary applies.
  caretaker_note: string | null;
  care_slots: SlotRow[];
  pets: PetRow[];
}

let period: PeriodRow | null = null;
let loadError = false;

if (periodId === null) {
  // Nothing to look up. Falls through to the same not-found branch below.
} else if (supabase) {
  const { data, error } = await supabase
    .from("care_periods")
    // `pets(...)` resolves the many-to-many through care_period_pets; see the list page for
    // why this embed is bounded and not a repeat of impl-review F8.
    .select(
      "id, title, start_date, end_date, revoked_at, caretaker_note, care_slots(id, slot_date, time_of_day, claimed_at, claimed_by_name, claim_digest), pets(id, name)",
    )
    .eq("id", periodId)
    .maybeSingle();
  if (error) {
    loadError = true;
  } else {
    period = data;
  }
} else {
  // Unconfigured Supabase is an error state, never an empty one.
  loadError = true;
}

// RLS makes "not yours" and "does not exist" the same answer, and so does this page —
// a real 404 status, not a soft empty state, so a probe learns nothing from either. A
// malformed id joins them rather than surfacing as a load error.
const notFound = !loadError && !period;
if (notFound) {
  Astro.response.status = 404;
}

// Group by day so the screen reads as a calendar rather than a flat list. Slots within
// a day follow the enum's declaration order, not whatever order PostgREST returned.
const slots = period?.care_slots ?? [];
const byDay = [...new Set(slots.map((slot) => slot.slot_date))].sort().map((day) => ({
  day,
  slots: TIMES_OF_DAY.map((time) => slots.find((slot) => slot.slot_date === day && slot.time_of_day === time)).filter(
    (slot) => slot !== undefined,
  ),
}));
const takenCount = slots.filter((slot) => slot.claimed_at !== null).length;

// Who holds what. Grouping happens once for the whole period rather than per day, because an
// ordinal is only meaningful against every other caretaker on the trip — a caretaker who holds
// Monday and Wednesday must carry the same number in both places.
//
// This is the last point at which `claim_digest` exists on this page: `groupCaretakers` takes
// it as input and returns labels that have no digest field. Nothing below may reach back into
// `slot.claim_digest`.
const caretakers = groupCaretakers(slots);

// Resolve each day's claimed terms to a rendered label HERE rather than in the template.
// Doing the lookup inline would leave `bySlotId.get(id)?.ordinal !== null` as the guard, and
// that is true when the map has no entry at all — `undefined !== null` — so a slot missing
// from the grouping would render an empty "()". `care_slots_claim_complete` makes that
// unreachable in theory, but contract-surfaces.md records that a direct owner UPDATE can break
// that very invariant, and this page is where the owner would see the result.
const claimedByDay = new Map(
  byDay.map((entry) => [
    entry.day,
    entry.slots
      .filter((slot) => slot.claimed_at !== null)
      .map((slot) => ({
        id: slot.id,
        time_of_day: slot.time_of_day,
        caretaker: caretakers.bySlotId.get(slot.id) ?? null,
      })),
  ]),
);
---

<Layout title={period?.title ?? "Wyjazd"}>
  <div class="bg-background min-h-screen px-5 py-8">
    <div class="mx-auto w-full max-w-2xl">
      <div class="mb-6 flex items-center justify-between gap-4">
        <a href="/periods" class="text-primary text-[13px] font-bold hover:underline">← Moje wyjazdy</a>
        <ThemeToggle initialTheme={theme} client:load />
      </div>

      {
        loadError && (
          <p
            role="alert"
            class="border-destructive/40 bg-destructive/10 text-destructive rounded-lg border-[1.5px] px-4 py-3 text-[14px]"
          >
            Nie udało się wczytać wyjazdu. Odśwież stronę.
          </p>
        )
      }

      {
        notFound && (
          <div class="border-border bg-card rounded-lg border-[1.5px] p-8 text-center">
            <p class="font-heading text-foreground text-[17px] font-bold">Nie znaleziono wyjazdu</p>
            <p class="text-muted-foreground mt-2 text-[15px]">Ten wyjazd nie istnieje albo nie należy do Ciebie.</p>
          </div>
        )
      }

      {
        period && (
          <>
            <h1 class="font-heading text-foreground text-[30px] leading-[1.15] font-bold">{period.title}</h1>
            <p class="text-primary mt-1 text-[15px] font-semibold">{formatRange(period.start_date, period.end_date)}</p>
            {/* Read-only chips, the same component the create form uses for its selector —
                see the list page for the empty-set reasoning, and for why `pets` needs no
                null guard where the list's aggregates do. */}
            {period.pets.length > 0 ? (
              <ul class="mt-1.5 flex flex-wrap gap-[10px]" aria-label="Zwierzęta w tym wyjeździe">
                {period.pets.map((pet) => (
                  <li>
                    <Chip>{pet.name}</Chip>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-muted-foreground mt-1 text-[15px]">Bez przypisanych zwierząt</p>
            )}
            {/* "Opiekunowie: N" rather than a declined noun: Polish agreement here would be
                1 opiekun / 2-4 opiekunów / 5+ opiekunów, and the label form sidesteps it
                without a pluralisation helper this repo does not otherwise need. The count is
                distinct CAPABILITIES, which is the closest the schema gets to "people" — see
                groupCaretakers for why that is not the same thing. */}
            <p class="text-muted-foreground mt-2 text-[13px]">
              {takenCount} z {slots.length} terminów zajętych
              {caretakers.caretakerCount > 0 && ` · opiekunowie: ${caretakers.caretakerCount}`}
              {period.revoked_at !== null && " · link został unieważniony"}
            </p>

            {/* Rendered only when there is one: createPeriodSchema normalises "" to NULL, so
                `caretaker_note !== null` is an honest test and an owner who typed nothing sees
                no empty box. `whitespace-pre-line` keeps the line breaks the owner typed —
                this is an address and a set of instructions, where a collapsed newline
                changes the meaning. The label states who reads it, mirroring the create
                form's hint: from Phase 3 on, only a caretaker who actually claimed a slot. */}
            {period.caretaker_note !== null && (
              <>
                <h2 class="font-heading text-foreground mt-8 mb-1 text-[17px] font-bold">Notatka</h2>
                <p class="text-muted-foreground mb-3 text-[13px]">Widzą ją tylko opiekunowie, którzy zajmą termin.</p>
                <p class="border-border bg-card text-foreground rounded-lg border-[1.5px] p-4 text-[15px] leading-[1.5] whitespace-pre-line">
                  {period.caretaker_note}
                </p>
              </>
            )}

            <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Terminy</h2>
            <ul class="space-y-3">
              {byDay.map((entry) => (
                <li class="border-border bg-card rounded-lg border-[1.5px] p-4">
                  <p class="text-foreground text-[15px] font-bold">
                    {formatDay(entry.day)}
                    <span class="text-muted-foreground ml-2 text-[13px] font-normal">{formatWeekday(entry.day)}</span>
                  </p>
                  <ul class="mt-3 grid grid-cols-3 gap-2">
                    {entry.slots.map((slot) => (
                      <li
                        class:list={[
                          "rounded-lg border-[1.5px] px-3 py-2 text-center text-[13px]",
                          slot.claimed_at === null
                            ? "border-input text-muted-foreground"
                            : "border-primary bg-secondary text-secondary-foreground font-bold",
                        ]}
                      >
                        <span class="block">{TIME_OF_DAY_LABEL[slot.time_of_day]}</span>
                        <span class="block text-[12px]">{slot.claimed_at === null ? "wolne" : "zajęte"}</span>
                      </li>
                    ))}
                  </ul>

                  {/* Names live BELOW the grid, not inside its cells, and that placement is
                      load-bearing rather than cosmetic. `grid-cols-3` compiles to
                      `repeat(3, minmax(0, 1fr))`, so a cell cannot grow and has no wrapping —
                      80 characters would paint straight over its neighbours. It would also put
                      an anon-written string immediately beside the literal "wolne" / "zajęte"
                      labels, separated only by colour and weight, so a caretaker named "wolne"
                      could pass as a status. Down here each name gets a full row, and the
                      release control (phase 3) gets somewhere to put its confirmation.

                      Days with nothing claimed render the grid alone — no empty list, no
                      heading for zero rows. */}
                  {(claimedByDay.get(entry.day) ?? []).length > 0 && (
                    <ul class="border-border mt-3 space-y-2 border-t pt-3">
                      {(claimedByDay.get(entry.day) ?? []).map((claimed) => (
                        <li class="flex flex-wrap items-center gap-3 text-[13px]">
                          <span class="text-muted-foreground w-[86px] shrink-0">
                            {TIME_OF_DAY_LABEL[claimed.time_of_day]}
                          </span>
                          {/* min-w-0 + truncate + title, following InviteLinkPanel.tsx:48 —
                              the repo's one precedent for a long string that must not break a
                              layout. NOT whitespace-pre-line: that is right for the owner's
                              own note above, and on an 80-character caretaker name it would
                              render 40 rows. */}
                          {/* <bdi> isolates the name's own direction. Stripping the explicit
                              bidi overrides in normalizeCaretakerName is necessary but not
                              sufficient: a name in a strong-RTL script still reorders the
                              neutral characters around it, which would drag the ordinal to the
                              visual left of the label it belongs to. */}
                          <bdi
                            class="text-foreground min-w-0 flex-1 truncate font-semibold"
                            title={claimed.caretaker?.label ?? UNNAMED_CARETAKER_LABEL}
                          >
                            {claimed.caretaker?.label ?? UNNAMED_CARETAKER_LABEL}
                          </bdi>
                          {claimed.caretaker?.ordinal != null && (
                            // A SIBLING of the truncating element, not a child: inside it the
                            // ordinal is the first thing an overflowing name clips away, so two
                            // caretakers who both type an 80-character name would render as two
                            // identical ellipsised rows — the page showing two people as one,
                            // which is the single outcome the ordinal exists to prevent.
                            // shrink-0 keeps it whole while the name absorbs the truncation.
                            <span class="text-muted-foreground shrink-0 font-normal">
                              ({claimed.caretaker.ordinal})
                            </span>
                          )}
                          {/* One island per CLAIMED term — this list is already filtered to
                              `claimed_at !== null`, so the control structurally cannot appear
                              on a free term. The props are ids plus the two already-rendered
                              labels; nothing derived from `claim_digest` crosses this line.
                              The row is flex-wrap so the island can drop to its own line when
                              it has an error to show, rather than squeezing the name. */}
                          <ReleaseSlotButton
                            periodId={period.id}
                            slotId={claimed.id}
                            caretakerLabel={claimed.caretaker?.label ?? UNNAMED_CARETAKER_LABEL}
                            termLabel={`${TIME_OF_DAY_LABEL[claimed.time_of_day]}, ${formatDay(entry.day)}`}
                            client:load
                          />
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>

            <h2 class="font-heading text-foreground mt-8 mb-3 text-[17px] font-bold">Link dla opiekuna</h2>
            <RegenerateLinkButton
              periodId={period.id}
              origin={Astro.url.origin}
              revoked={period.revoked_at !== null}
              client:load
            />
          </>
        )
      }
    </div>
  </div>
</Layout>
