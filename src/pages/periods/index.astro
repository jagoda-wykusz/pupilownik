---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import { Button } from "@/components/ui/button";
import { Chip } from "@/components/ui/Chip";
import { createClient } from "@/lib/supabase";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";
import { countDays, formatRange } from "@/lib/period-format";

// Protected by middleware (PROTECTED_ROUTES includes "/periods"): an unauthenticated
// request is redirected to /auth/signin before this frontmatter runs. The query below
// carries no owner filter — RLS scopes it to the caller's own periods.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);

// Bounded read. Paging is not worth building for an owner with a handful of trips, but
// an unbounded query is not worth shipping either.
const PERIODS_PAGE_SIZE = 100;

// PostgREST returns an aggregate embed as a one-element array.
interface CountRow {
  count: number;
}
interface PetRow {
  id: string;
  name: string;
}
interface PeriodRow {
  id: string;
  title: string;
  start_date: string;
  end_date: string;
  revoked_at: string | null;
  total: CountRow[];
  taken: CountRow[];
  pets: PetRow[];
}

let periods: PeriodRow[] = [];
let loadError = false;

if (supabase) {
  // Counts are aggregated in the database rather than by pulling every slot row: at the
  // 93-slot cap, a screenful of periods would otherwise be thousands of rows fetched to
  // produce two integers. It also means claimed_by_name never reaches this page — a slot
  // taker's identity is S-04's (FR-006), and a page that cannot see it cannot leak it.
  // The `taken` filter narrows the aliased embed only, so periods with nothing claimed
  // still come back, with taken = 0.
  const { data, error } = await supabase
    .from("care_periods")
    // `pets(...)` traverses care_period_pets automatically — PostgREST resolves the
    // many-to-many from the join table's two foreign keys, so the join table never appears
    // here. Unlike the slot rows impl-review F8 removed, this embed is bounded by pets per
    // trip (a household, not 93 slots), so it is not a repeat of that finding.
    .select(
      "id, title, start_date, end_date, revoked_at, total:care_slots(count), taken:care_slots(count), pets(id, name)",
    )
    .not("taken.claimed_by_name", "is", null)
    .order("start_date", { ascending: false })
    .limit(PERIODS_PAGE_SIZE);
  if (error) {
    loadError = true;
  } else {
    periods = data;
  }
} else {
  // A null client means Supabase is unconfigured — surface it as an error rather than
  // an empty list, so a misconfiguration doesn't masquerade as "no periods".
  loadError = true;
}
---

<Layout title="Moje wyjazdy">
  <div class="bg-background min-h-screen px-5 py-8">
    <div class="mx-auto w-full max-w-2xl">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="font-heading text-foreground text-[30px] leading-[1.15] font-bold">Moje wyjazdy</h1>
        <ThemeToggle initialTheme={theme} client:load />
      </div>

      {
        loadError && (
          <p
            role="alert"
            class="border-destructive/40 bg-destructive/10 text-destructive rounded-lg border-[1.5px] px-4 py-3 text-[14px]"
          >
            Nie udało się wczytać wyjazdów. Odśwież stronę.
          </p>
        )
      }

      {
        !loadError && periods.length === 0 && (
          <div class="border-border bg-card rounded-lg border-[1.5px] p-8 text-center">
            <p class="text-muted-foreground mb-4 text-[15px]">Nie masz jeszcze żadnego wyjazdu.</p>
            <Button asChild>
              <a href="/periods/new">Zaplanuj pierwszy wyjazd</a>
            </Button>
          </div>
        )
      }

      {
        periods.length > 0 && (
          <>
            <ul class="space-y-3">
              {periods.map((period) => {
                const takenCount = period.taken[0]?.count ?? 0;
                const totalCount = period.total[0]?.count ?? 0;
                return (
                  <li>
                    <a
                      href={`/periods/${period.id}`}
                      class="border-border bg-card hover:border-ring block rounded-lg border-[1.5px] p-5 transition-colors"
                    >
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-heading text-foreground text-[17px] font-bold">{period.title}</span>
                        <span class="text-muted-foreground shrink-0 text-[13px]">
                          {countDays(period.start_date, period.end_date)} dni
                        </span>
                      </div>
                      <p class="text-primary mt-1 text-[13px] font-semibold">
                        {formatRange(period.start_date, period.end_date)}
                      </p>
                      {/* A trip with no pets is representable by design (see the plan's
                          Critical Implementation Details), so this has to say something
                          rather than render an empty line. Chips rather than a joined
                          string: each pet reads as its own object, which is what the card
                          is listing. ui/Chip without onToggle renders a <span> — the whole
                          card is an <a>, and a nested <button> would be invalid HTML. */}
                      {period.pets.length > 0 ? (
                        <div class="mt-1.5 flex flex-wrap gap-[10px]">
                          {period.pets.map((pet) => (
                            <Chip>{pet.name}</Chip>
                          ))}
                        </div>
                      ) : (
                        <p class="text-muted-foreground mt-1 text-[13px]">Bez przypisanych zwierząt</p>
                      )}
                      <p class="text-muted-foreground mt-2 text-[13px]">
                        {takenCount} z {totalCount} terminów zajętych
                        {period.revoked_at !== null && " · link nieaktywny"}
                      </p>
                    </a>
                  </li>
                );
              })}
            </ul>

            <div class="mt-6">
              <Button asChild className="w-full">
                <a href="/periods/new">+ Nowy wyjazd</a>
              </Button>
            </div>
          </>
        )
      }
    </div>
  </div>
</Layout>
