---
import Layout from "@/layouts/Layout.astro";
import AuthScreen from "@/components/ui/AuthScreen.astro";
import ScreenHeading from "@/components/ui/ScreenHeading.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zaloguj się">
  <AuthScreen heroTitle="Pupilownik" heroSubtitle="Rozłóż opiekę nad pupilami między zaufane osoby.">
    <ScreenHeading
      title="Cześć!"
      titleSecondLine="Miło Cię znów widzieć"
      subtitle="Zaloguj się, aby zająć się swoimi pupilami."
    />
    <SignInForm serverError={error} client:load />
    <p class="text-muted-foreground mt-7 text-center text-[14px]">
      Nie masz konta? <a href="/auth/signup" class="text-primary font-extrabold hover:underline">Załóż konto</a>
    </p>
  </AuthScreen>
</Layout>
