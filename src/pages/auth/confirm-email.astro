---
import Layout from "@/layouts/Layout.astro";
import AuthScreen from "@/components/ui/AuthScreen.astro";
import ScreenHeading from "@/components/ui/ScreenHeading.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Konto założone",
      description: "Twoje konto jest gotowe. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <AuthScreen>
    <div class="text-center">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <ScreenHeading title={content.heading} subtitle={content.description} />
      <a href="/auth/signin" class="text-primary text-[14px] font-extrabold hover:underline">
        {content.linkText}
      </a>
    </div>
  </AuthScreen>
</Layout>
