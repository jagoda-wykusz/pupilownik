---
import Layout from "@/layouts/Layout.astro";
import AuthScreen from "@/components/ui/AuthScreen.astro";
import ScreenHeading from "@/components/ui/ScreenHeading.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Załóż konto">
  <AuthScreen heroTitle="Pupilownik" heroSubtitle="Jeden link zamiast dziesięciu wiadomości.">
    <ScreenHeading
      title="Zaczynajmy!"
      titleSecondLine="Załóż konto"
      subtitle="Dodaj swoich pupili i zaproś opiekunów."
    />
    <SignUpForm serverError={error} client:load />
    <p class="text-muted-foreground mt-7 text-center text-[14px]">
      Masz już konto? <a href="/auth/signin" class="text-primary font-extrabold hover:underline">Zaloguj się</a>
    </p>
  </AuthScreen>
</Layout>
