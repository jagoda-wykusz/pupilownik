---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

// Protected by middleware (PROTECTED_ROUTES includes "/pets"): an unauthenticated
// request is redirected to /auth/signin before this frontmatter runs. The query
// below carries no owner filter — RLS scopes it to the caller's own pets.
const supabase = createClient(Astro.request.headers, Astro.cookies);

interface InstructionRow {
  id: string;
  title: string;
  is_sensitive: boolean;
}
interface PetRow {
  id: string;
  name: string;
  species: string;
  breed: string | null;
  age: string | null;
  care_instructions: InstructionRow[];
}

let pets: PetRow[] = [];
let loadError = false;

if (supabase) {
  const { data, error } = await supabase
    .from("pets")
    .select("id, name, species, breed, age, care_instructions(id, title, is_sensitive)")
    .order("created_at", { ascending: false });
  if (error) {
    loadError = true;
  } else {
    // In the no-error branch PostgREST's discriminated response types data as non-null.
    pets = data;
  }
} else {
  // A null client means Supabase is unconfigured — surface it as an error rather
  // than an empty list, so a misconfiguration doesn't masquerade as "no pets".
  loadError = true;
}

const SPECIES_LABEL: Record<string, string> = { dog: "Pies", cat: "Kot", other: "Inne" };
---

<Layout title="Moje zwierzęta">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl py-10 text-white">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Moje zwierzęta
        </h1>
        <a
          href="/pets/new"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          + Dodaj zwierzę
        </a>
      </div>

      {
        loadError && (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-4 py-3 text-sm text-red-300">
            Nie udało się wczytać zwierząt. Odśwież stronę.
          </p>
        )
      }

      {
        !loadError && pets.length === 0 && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-10 text-center text-blue-100/70 backdrop-blur-xl">
            <p class="mb-4">Nie masz jeszcze żadnych zwierząt.</p>
            <a href="/pets/new" class="text-purple-300 hover:underline">
              Dodaj pierwsze zwierzę →
            </a>
          </div>
        )
      }

      {
        pets.length > 0 && (
          <ul class="grid gap-4 sm:grid-cols-2">
            {pets.map((pet) => {
              const sensitiveCount = pet.care_instructions.filter((i) => i.is_sensitive).length;
              return (
                <li class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl">
                  <div class="mb-1 flex items-baseline justify-between">
                    <h2 class="text-xl font-semibold text-white">{pet.name}</h2>
                    <span class="text-xs text-blue-100/60">{SPECIES_LABEL[pet.species] ?? pet.species}</span>
                  </div>
                  <p class="text-sm text-blue-100/70">
                    {[pet.breed, pet.age].filter(Boolean).join(" · ") || "Brak dodatkowych danych"}
                  </p>
                  <p class="mt-3 flex items-center gap-2 text-xs text-blue-100/60">
                    <span>
                      {pet.care_instructions.length} {pet.care_instructions.length === 1 ? "instrukcja" : "instrukcji"}
                    </span>
                    {sensitiveCount > 0 && (
                      <span class="rounded-full bg-amber-500/20 px-2 py-0.5 text-amber-200">
                        {sensitiveCount} wrażliwe
                      </span>
                    )}
                  </p>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
