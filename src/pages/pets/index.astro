---
import Layout from "@/layouts/Layout.astro";
import AppBar from "@/components/AppBar.astro";
import { Button } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";
import { SPECIES_LABEL, type Species } from "@/lib/pet-format";

// Protected by middleware (PROTECTED_ROUTES includes "/pets"): an unauthenticated
// request is redirected to /auth/signin before this frontmatter runs. The query
// below carries no owner filter — RLS scopes it to the caller's own pets.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);

interface InstructionRow {
  id: string;
  title: string;
  is_sensitive: boolean;
}
interface PetRow {
  id: string;
  name: string;
  // The enum, not `string`: SPECIES_LABEL is keyed by pet_species, so a widened type here
  // makes the lookup an implicit `any` (ts7053) — which is exactly what slipped past the
  // toolchain when this screen moved onto the shared map in S-03 Phase 3.
  species: Species;
  breed: string | null;
  age: string | null;
  care_instructions: InstructionRow[];
}

let pets: PetRow[] = [];
let loadError = false;

if (supabase) {
  const { data, error } = await supabase
    .from("pets")
    .select("id, name, species, breed, age, care_instructions(id, title, is_sensitive)")
    .order("created_at", { ascending: false });
  if (error) {
    loadError = true;
  } else {
    // In the no-error branch PostgREST's discriminated response types data as non-null.
    pets = data;
  }
} else {
  // A null client means Supabase is unconfigured — surface it as an error rather
  // than an empty list, so a misconfiguration doesn't masquerade as "no pets".
  loadError = true;
}
---

<Layout title="Moje zwierzęta">
  <div class="bg-background min-h-screen px-5 py-8">
    <div class="mx-auto w-full max-w-2xl">
      <AppBar theme={theme}>
        <h1 class="font-heading text-foreground text-[30px] leading-[1.15] font-bold">Moje zwierzęta</h1>
      </AppBar>

      {
        loadError && (
          <p
            role="alert"
            class="border-destructive/40 bg-destructive/10 text-destructive rounded-lg border-[1.5px] px-4 py-3 text-[14px]"
          >
            Nie udało się wczytać zwierząt. Odśwież stronę.
          </p>
        )
      }

      {
        !loadError && pets.length === 0 && (
          <div class="border-border bg-card rounded-lg border-[1.5px] p-8 text-center">
            <p class="text-muted-foreground mb-4 text-[15px]">Nie masz jeszcze żadnego zwierzęcia.</p>
            <Button asChild>
              <a href="/pets/new">Dodaj pierwsze zwierzę</a>
            </Button>
          </div>
        )
      }

      {
        pets.length > 0 && (
          <>
            <ul class="space-y-3">
              {pets.map((pet) => {
                const sensitiveCount = pet.care_instructions.filter((i) => i.is_sensitive).length;
                return (
                  <li>
                    {/* The whole card is the link, following /periods/index.astro rather than
                        adding a per-card button: this page carries no island of its own beyond
                        the AppBar's theme switch (tests/render/island-props.test.ts), and an
                        interactive control here would raise that floor. Edit and delete both
                        live on the detail page. Nothing interactive may be nested inside this
                        anchor. */}
                    <a
                      href={`/pets/${pet.id}`}
                      class="border-border bg-card hover:border-ring block rounded-lg border-[1.5px] p-5 transition-colors"
                    >
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="font-heading text-foreground text-[17px] font-bold">{pet.name}</span>
                        <span class="text-muted-foreground shrink-0 text-[13px]">{SPECIES_LABEL[pet.species]}</span>
                      </div>
                      <p class="text-primary mt-1 text-[13px] font-semibold">
                        {[pet.breed, pet.age].filter(Boolean).join(" · ") || "Brak dodatkowych danych"}
                      </p>
                      <p class="text-muted-foreground mt-2 flex flex-wrap items-center gap-2 text-[13px]">
                        <span>
                          {pet.care_instructions.length}{" "}
                          {pet.care_instructions.length === 1 ? "instrukcja" : "instrukcji"}
                        </span>
                        {/* The sensitive count is a warning tone rather than the accent: it
                            says "some of this is hidden from a caretaker until they claim a
                            term", which is a different kind of fact from the species line. */}
                        {sensitiveCount > 0 && (
                          <span class="border-primary bg-secondary text-secondary-foreground rounded-[24px] border-[1.5px] px-2.5 py-0.5 text-[12px] font-bold">
                            {sensitiveCount} wrażliwe
                          </span>
                        )}
                      </p>
                    </a>
                  </li>
                );
              })}
            </ul>

            <div class="mt-6">
              <Button asChild className="w-full">
                <a href="/pets/new">+ Dodaj zwierzę</a>
              </Button>
            </div>
          </>
        )
      }
    </div>
  </div>
</Layout>
