---
import Layout from "@/layouts/Layout.astro";
import AppBar from "@/components/AppBar.astro";
import ScreenHeading from "@/components/ui/ScreenHeading.astro";
import AddPetForm from "@/components/pets/AddPetForm";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";

// Protected by middleware (PROTECTED_ROUTES includes "/pets"): an unauthenticated
// request is redirected to /auth/signin before this frontmatter runs.
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
---

<Layout title="Dodaj zwierzę">
  <div class="bg-background min-h-screen px-5 py-8">
    <div class="mx-auto w-full max-w-md">
      <AppBar theme={theme}>
        <a href="/pets" class="text-primary text-[13px] font-bold hover:underline">← Moje zwierzęta</a>
      </AppBar>

      <ScreenHeading
        title="Dodaj zwierzę"
        subtitle="Imię wystarczy na start. Instrukcje opieki możesz uzupełnić teraz albo później."
      />

      <AddPetForm client:load />
    </div>
  </div>
</Layout>
