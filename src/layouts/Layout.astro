---
import { Font } from "astro:assets";
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { resolveTheme, THEME_COOKIE } from "@/lib/theme";

interface Props {
  title?: string;
}

const { title = "Pupilownik" } = Astro.props;

// Resolved during SSR so the very first painted frame already carries the right
// palette — no client script, no flash of the wrong theme. An empty string means
// the visitor has chosen nothing yet; global.css then honours their OS preference.
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
---

<!doctype html>
<html lang="pl" class:list={[theme]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Font cssVariable="--font-quicksand" preload />
    <Font cssVariable="--font-nunito" preload />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
